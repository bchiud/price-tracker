# Copy to .env and fill in. Never commit .env — the bot token controls your bot.

# Developer Portal → your app → Bot → Reset Token
DISCORD_BOT_TOKEN=
# Your server's ID (Developer Mode on → right-click server → Copy Server ID); makes slash commands appear instantly
DISCORD_GUILD_ID=

# Optional overrides (defaults shown)
# CHECK_INTERVAL_HOURS=12
# DB_PATH=price_tracker.db
# REQUEST_TIMEOUT_SECONDS=20
